root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# C# Naming Conventions (based on .NET runtime style)
# https://docs.microsoft.com/en-us/dotnet/csharp/fundamentals/coding-style/coding-conventions

# Private fields
dotnet_naming_rule.private_fields_should_be_camelcase.severity = warning
dotnet_naming_rule.private_fields_should_be_camelcase.symbols = private_fields
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = 
dotnet_naming_style.private_fields.should_prefix_with_underscore = true
dotnet_naming_style.private_fields.should_be_camelcase = true
dotnet_naming_style.private_fields.capitalization = camel_case

# Internal fields (same as private)
dotnet_naming_rule.internal_fields_should_be_camelcase.severity = warning
dotnet_naming_rule.internal_fields_should_be_camelcase.symbols = internal_fields
dotnet_naming_symbols.internal_fields.applicable_kinds = field
dotnet_naming_symbols.internal_fields.applicable_accessibilities = internal
dotnet_naming_style.internal_fields.should_prefix_with_underscore = true
dotnet_naming_style.internal_fields.should_be_camelcase = true
dotnet_naming_style.internal_fields.capitalization = camel_case

# Public fields (PascalCase)
dotnet_naming_rule.public_fields_should_be_pascalcase.severity = warning
dotnet_naming_rule.public_fields_should_be_pascalcase.symbols = public_fields
dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public
dotnet_naming_style.public_fields.should_be_pascalcase = true
dotnet_naming_style.public_fields.capitalization = pascal_case

# Constants (PascalCase)
dotnet_naming_rule.constants_should_be_pascalcase.severity = warning
dotnet_naming_rule.constants_should_be_pascalcase.symbols = constants
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.constants.should_be_pascalcase = true
dotnet_naming_style.constants.capitalization = pascal_case

# Static fields (camelCase)
dotnet_naming_rule.static_fields_should_be_camelcase.severity = warning
dotnet_naming_rule.static_fields_should_be_camelcase.symbols = static_fields
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_style.static_fields.should_prefix_with_underscore = true
dotnet_naming_style.static_fields.should_be_camelcase = true
dotnet_naming_style.static_fields.capitalization = camel_case

# Properties (PascalCase)
dotnet_naming_rule.properties_should_be_pascalcase.severity = warning
dotnet_naming_rule.properties_should_be_pascalcase.symbols = properties
dotnet_naming_symbols.properties.applicable_kinds = property
dotnet_naming_style.properties.should_be_pascalcase = true
dotnet_naming_style.properties.capitalization = pascal_case

# Parameters (camelCase)
dotnet_naming_rule.parameters_should_be_camelcase.severity = warning
dotnet_naming_rule.parameters_should_be_camelcase.symbols = parameters
dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_style.parameters.should_be_camelcase = true
dotnet_naming_style.parameters.capitalization = camel_case

# Methods (PascalCase)
dotnet_naming_rule.methods_should_be_pascalcase.severity = warning
dotnet_naming_rule.methods_should_be_pascalcase.symbols = methods
dotnet_naming_symbols.methods.applicable_kinds = method
dotnet_naming_style.methods.should_be_pascalcase = true
dotnet_naming_style.methods.capitalization = pascal_case

# Classes (PascalCase)
dotnet_naming_rule.classes_should_be_pascalcase.severity = warning
dotnet_naming_rule.classes_should_be_pascalcase.symbols = classes
dotnet_naming_symbols.classes.applicable_kinds = class
dotnet_naming_style.classes.should_be_pascalcase = true
dotnet_naming_style.classes.capitalization = pascal_case

# Interfaces (IPascalCase)
dotnet_naming_rule.interfaces_should_be_ipascalcase.severity = warning
dotnet_naming_rule.interfaces_should_be_ipascalcase.symbols = interfaces
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.interfaces.should_be_pascalcase = true
dotnet_naming_style.interfaces.capitalization = pascal_case
dotnet_naming_style.interfaces.required_prefix = I

# Enums (PascalCase)
dotnet_naming_rule.enums_should_be_pascalcase.severity = warning
dotnet_naming_rule.enums_should_be_pascalcase.symbols = enums
dotnet_naming_symbols.enums.applicable_kinds = enum
dotnet_naming_style.enums.should_be_pascalcase = true
dotnet_naming_style.enums.capitalization = pascal_case

# Enum members (PascalCase)
dotnet_naming_rule.enum_members_should_be_pascalcase.severity = warning
dotnet_naming_rule.enum_members_should_be_pascalcase.symbols = enum_members
dotnet_naming_symbols.enum_members.applicable_kinds = enum_member
dotnet_naming_style.enum_members.should_be_pascalcase = true
dotnet_naming_style.enum_members.capitalization = pascal_case

# IDE0005: Using directive is unnecessary
dotnet_diagnostic.IDE0005.severity = suggestion

# IDE0008: Add explicit cast
dotnet_diagnostic.IDE0008.severity = none

# CA1014: Mark assemblies with CLSCompliantAttribute
dotnet_diagnostic.CA1014.severity = none

# CS0618: Member is obsolete
dotnet_diagnostic.CS0618.severity = warning

# CS0628: Member will not be available in current context
dotnet_diagnostic.CS0628.severity = warning

# CS8597: Member returning instance dictionary must be non-nullable
dotnet_diagnostic.CS8597.severity = none

# CS8618: Non-nullable member is uninitialized
dotnet_diagnostic.CS8618.severity = warning

# CS8620: Reference in parameter may be null
dotnet_diagnostic.CS8620.severity = warning

# CS8625: Cannot convert null to reference type
dotnet_diagnostic.CS8625.severity = warning

# SA1200: Using directive should appear within a namespace declaration
dotnet_diagnostic.SA1200.severity = none

# SYSLIB001: Type or member is obsolete
dotnet_diagnostic.SYSLIB001.severity = warning