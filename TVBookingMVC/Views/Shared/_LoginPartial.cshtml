@using Microsoft.AspNetCore.Identity
@using TVBookingMVC.Areas.Identity.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a id="manage" class="nav-link">
                <i class="bi bi-person-circle me-1"></i>@UserManager.GetUserName(User)
            </a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Booking", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link border-0">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </form>
        </li>
        @if (!User.IsInRole(RoleNames.Admin))
        {
            <li class="nav-item">
                <form class="form-inline" asp-controller="Account" asp-action="Checkout" method="post"
                      onsubmit="return confirm('Are you sure you want to check out of the hotel? This will permanently delete your account and all bookings.');">
                    <button type="submit" class="nav-link btn btn-link border-0">
                        <i class="bi bi-door-open me-1"></i>Checkout
                    </button>
                </form>
            </li>
        }
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" id="login" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Login
            </a>
        </li>
    }
</ul>