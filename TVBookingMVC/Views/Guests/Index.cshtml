@using Microsoft.AspNetCore.Identity
@using TVBookingMVC.Areas.Identity.Data
@using TVBookingMVC.Constants

@inject UserManager<ApplicationUser> UserManager

@model TVBookingMVC.ViewModels.ManageGuestsViewModel

@{
    ViewData["Title"] = "Manage Guests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header d-flex justify-content-between align-items-center page-content">
    <h1><i class="bi bi-people"></i> @ViewData["Title"]</h1>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Register guest
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table id="guestsTable" class="table table-striped table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th class="text-center">Room Number</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td class="text-center">
                                @user.RoomNumber
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2 align-items-center flex-wrap">
                                    <form asp-action="AssignRoom" method="post" class="d-flex gap-1 align-items-center">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <select name="roomNumber" class="form-select form-select-sm" style="width: auto; min-width: 110px;" required>
                                            @if (Model.AvailableRooms.Count == 0)
                                            {
                                                <option value="" disabled selected>No rooms free</option>
                                            }
                                            else
                                            {
                                                <option value="" disabled selected>Assign room...</option>
                                                @foreach (var room in Model.AvailableRooms)
                                                {
                                                    <option value="@room">@room</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Assign room"
                                                @(Model.AvailableRooms.Count == 0 ? "disabled" : "")>
                                            <i class="bi bi-arrow-right-circle"></i>
                                        </button>
                                    </form>
                                    @if (!await UserManager.IsInRoleAsync(user, RoleNames.Admin))
                                    {
                                        <form asp-action="Delete" method="post"
                                              onsubmit="return confirm('Delete guest @user.Email and all their bookings?');">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete guest">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.AvailableRooms.Count == 0)
        {
            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle me-1"></i>All rooms are occupied.
            </div>
        }
        else
        {
            <div class="mt-3 text-muted small">
                <i class="bi bi-door-open me-1"></i>@Model.AvailableRooms.Count available room(s)
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#guestsTable').DataTable({
                responsive: true,
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                order: [[1, 'asc']],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search guests...",
                    emptyTable: "No guests registered",
                    zeroRecords: "No matching guests found"
                }
            });
        });
    </script>
}
