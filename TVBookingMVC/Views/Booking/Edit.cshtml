@model TVBookingMVC.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var channels = ViewBag.Channels as IEnumerable<string> ?? Array.Empty<string>();
    var genres = ViewBag.Genres as IEnumerable<string> ?? Array.Empty<string>();
    var ageLimits = ViewBag.AgeLimits as IEnumerable<string> ?? Array.Empty<string>();

    var returnAgeLimits = ViewBag.ReturnAgeLimits as string[] ?? Array.Empty<string>();
    var returnQuery = string.Join("&", returnAgeLimits.Select(a => $"ageLimit={Uri.EscapeDataString(a)}"));
    var returnQueryPrefix = !string.IsNullOrEmpty(returnQuery) ? "?" + returnQuery : "";

    var returnUrl = ViewBag.ReturnUrl as string;
    var isReturnUrlValid = !string.IsNullOrEmpty(returnUrl);
}

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
}

<div class="page-header page-content">
    <h1><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h1>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Booking Details</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    @foreach (var al in returnAgeLimits)
                    {
                        <input type="hidden" name="ageLimit" value="@al" />
                    }
                    @if (isReturnUrlValid)
                    {
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                    }
                    <div class="form-floating mb-3">
                        <input asp-for="Program" class="form-control" placeholder="Program name" />
                        <label asp-for="Program" class="form-label">Program Name</label>
                        <span asp-validation-for="Program" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Channel" class="form-select" asp-items="@(new SelectList(channels))">
                                    <option value="">Select Channel</option>
                                </select>
                                <label asp-for="Channel" class="form-label">Channel</label>
                                <span asp-validation-for="Channel" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Genre" class="form-select" asp-items="@(new SelectList(genres))">
                                    <option value="">Select Genre</option>
                                </select>
                                <label asp-for="Genre" class="form-label">Genre</label>
                                <span asp-validation-for="Genre" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Start" class="form-control" type="text" asp-format="{0:yyyy/MM/dd HH:mm}" placeholder="yyyy/MM/dd HH:mm" />
                                <label asp-for="Start" class="form-label">Start Time</label>
                                <span asp-validation-for="Start" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="End" class="form-control" type="text" asp-format="{0:yyyy/MM/dd HH:mm}" placeholder="yyyy/MM/dd HH:mm" />
                                <label asp-for="End" class="form-label">End Time</label>
                                <span asp-validation-for="End" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="AgeLimit" class="form-select" asp-items="@(new SelectList(ageLimits))">
                                    <option value="">Select Age Limit</option>
                                </select>
                                <label asp-for="AgeLimit" class="form-label">Age Limit</label>
                                <span asp-validation-for="AgeLimit" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                @if (User.IsInRole(RoleNames.Admin))
                                {
                                    <input asp-for="RoomNumber" class="form-control" placeholder="Room number" />
                                }
                                else
                                {
                                    <input asp-for="RoomNumber" class="form-control" readonly />
                                }
                                <label asp-for="RoomNumber" class="form-label">Room Number</label>
                                <span asp-validation-for="RoomNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Update Booking
                        </button>
                        <a href="@(isReturnUrlValid ? returnUrl : Url.Action("Index") + returnQueryPrefix)" class="btn btn-secondary">
                            <i class="bi bi-x-lg me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-clock me-2"></i>Available Time Slots</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.FreeTimeSlots != null && ((IEnumerable<TVBookingMVC.ViewModels.FreeTimeSlot>)ViewBag.FreeTimeSlots).Any())
                {
                    @await Html.PartialAsync("_FreeTimeSlotsTable", (IEnumerable<TVBookingMVC.ViewModels.FreeTimeSlot>)ViewBag.FreeTimeSlots)
                }
                else
                {
                    <p class="text-muted mb-0">No free time slots available at the moment.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="@(isReturnUrlValid ? returnUrl : Url.Action("Index") + returnQueryPrefix)" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        $(document).ready(function() {
            if ($.fn.dataTable) {
                $('#freeSlotsTable').DataTable({
                    responsive: true,
                    pageLength: 25,
                    lengthMenu: [10, 25, 50, 100],
                    order: [[0, 'asc']],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search...",
                        emptyTable: "No free time slots available",
                        zeroRecords: "No matching slots found"
                    }
                });
            }
        });

        $.validator.methods.date = function(value, element) {
            return this.optional(element) || /^\d{4}\/\d{2}\/\d{2} \d{2}:\d{2}$/.test(value);
        };

        flatpickr('[name="Start"], [name="End"]', {
            enableTime: true,
            dateFormat: "Y/m/d H:i",
            time_24hr: true,
            minuteIncrement: 1,
            allowInput: true
        });

        function addValidationClasses() {
            var fields = ['Program', 'Channel', 'Genre', 'Start', 'End', 'AgeLimit', 'RoomNumber'];
            fields.forEach(function(field) {
                var errorSpan = document.querySelector('span[data-valmsg-for="' + field + '"]');
                if (errorSpan && errorSpan.textContent.trim()) {
                    var input = document.querySelector('[name="' + field + '"]');
                    if (input) input.classList.add('is-invalid');
                }
            });
        }
        
        addValidationClasses();
        setTimeout(addValidationClasses, 100);
    </script>
}
