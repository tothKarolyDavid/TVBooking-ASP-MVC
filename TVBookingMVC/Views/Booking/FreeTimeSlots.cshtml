@model System.Collections.Generic.List<TVBookingMVC.ViewModels.FreeTimeSlot>

@{
    ViewData["Title"] = "Free Time Slots";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var returnAgeLimits = ViewBag.ReturnAgeLimits as string[] ?? Array.Empty<string>();
    var returnQuery = string.Join("&", returnAgeLimits.Select(a => $"ageLimit={Uri.EscapeDataString(a)}"));
    var returnQueryPrefix = !string.IsNullOrEmpty(returnQuery) ? "?" + returnQuery : "";
}

<div class="page-header page-content">
    <h1><i class="bi bi-clock"></i> @ViewData["Title"]</h1>
    <p class="text-muted">Available time slots for the next 7 days</p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <table id="freeSlotsTable" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Available From</th>
                    <th>Available To</th>
                    <th>Duration</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Start.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>@item.End.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            @{
                                var duration = item.End - item.Start;
                                var hours = (int)duration.TotalHours;
                                var minutes = duration.Minutes;
                                if (hours > 0)
                                {
                                    <span>@hours h @minutes min</span>
                                }
                                else
                                {
                                    <span>@minutes min</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Create" asp-route-ageLimit="@ViewBag.ReturnAgeLimits" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Create Booking
    </a>
    <a href="@Url.Action("Index")@returnQueryPrefix" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#freeSlotsTable').DataTable({
                responsive: true,
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                order: [[0, 'asc']],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search...",
                    emptyTable: "No free time slots available",
                    zeroRecords: "No matching slots found"
                }
            });
        });
    </script>
}