@model TVBookingMVC.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-content">
    <h1><i class="bi bi-trash"></i> @ViewData["Title"]</h1>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Are you sure you want to delete this booking?</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Program</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Program)</dd>

                    <dt class="col-sm-4">Channel</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Channel)</dd>

                    <dt class="col-sm-4">Genre</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Genre)</dd>

                    <dt class="col-sm-4">Start</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Start)</dd>

                    <dt class="col-sm-4">End</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.End)</dd>

                    <dt class="col-sm-4">Age Limit</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.AgeLimit)</dd>

                    <dt class="col-sm-4">Room Number</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.RoomNumber)</dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-2"></i>Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-lg me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>