@using Microsoft.AspNetCore.Identity
@using TVBookingMVC.Areas.Identity.Data
@using TVBookingMVC.Constants


@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@model TVBookingMVC.ViewModels.BookingIndexViewModel

@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var filterParams = new List<string>();
    filterParams.AddRange(Model.SelectedAgeLimits.Select(a => $"ageLimit={Uri.EscapeDataString(a)}"));
    if (Model.MyBookings)
    {
        filterParams.Add("myBookings=true");
    }
    var filterQuery = string.Join("&", filterParams);
    var filterQueryPrefix = !string.IsNullOrEmpty(filterQuery) ? "?" + filterQuery : "";
}

<div class="page-header d-flex justify-content-between align-items-center page-content">
    <h1><i class="bi bi-list-check"></i> @ViewData["Title"]</h1>
    
    @if (SignInManager.IsSignedIn(User))
    {
        <a href="@Url.Action("Create", "Booking")@(filterQueryPrefix)" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Create booking
        </a>
    }
</div>

@if (SignInManager.IsSignedIn(User))
{
    <div class="mb-3">
        <button type="button" id="myBookingsToggle"
                class="btn @(Model.MyBookings ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">
            <i class="bi @(Model.MyBookings ? "bi-toggle-on" : "bi-toggle-off") me-2"></i>Show only my bookings
        </button>
    </div>
}

<div class="card mb-3">
    <div class="card-header" data-bs-toggle="collapse" data-bs-target="#filterCollapse" role="button" aria-expanded="true">
        <h5 class="mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-funnel me-1"></i>Filter by Age Limit
            @if (Model.SelectedAgeLimits.Length > 0)
            {
                <span class="badge bg-primary rounded-pill">@Model.SelectedAgeLimits.Length</span>
            }
            <i class="bi bi-chevron-down ms-auto transition-rotate rotated"></i>
        </h5>
    </div>
    <div class="collapse show" id="filterCollapse">
        <div class="card-body filter-checks">
            <form asp-action="Index" method="get" id="filterForm">
                <input type="hidden" name="myBookings" id="myBookingsInput" value="@(Model.MyBookings ? "true" : "false")" />
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @foreach (var ageLimit in Model.AgeLimits)
                    {
                        bool isChecked = Model.SelectedAgeLimits.Contains(ageLimit);
                        <div class="form-check">
                            <input class="form-check-input filter-checkbox" type="checkbox" name="ageLimit" value="@ageLimit" @(isChecked ? "checked" : "") id="age-@ageLimit" />
                            <label class="form-check-label" for="age-@ageLimit">@ageLimit</label>
                        </div>
                    }
                </div>
                @if (Model.SelectedAgeLimits.Length > 0 || Model.MyBookings)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </a>
                }
            </form>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table id="bookingsTable" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Program</th>
                    <th>Channel</th>
                    <th>Genre</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Age Limit</th>
                    <th>Room</th>
                    @if (User.IsInRole(RoleNames.Admin) || SignInManager.IsSignedIn(User))
                    {
                        <th class="text-center">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Bookings)
                {
                    var canManage = User.IsInRole(RoleNames.Admin) || (Model.CurrentUserRoomNumber.HasValue && item.RoomNumber == Model.CurrentUserRoomNumber.Value);
                    <tr>
                        <td>@item.Program</td>
                        <td>@item.Channel</td>
                        <td>@item.Genre</td>
                        <td>@item.Start.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>@item.End.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            @if (item.AgeLimit is "Adults Only" or "Under 18 not recommended")
                            {
                                <span class="badge bg-danger">@item.AgeLimit</span>
                            }
                            else if (item.AgeLimit is "Under 16 not recommended" or "Under 12 not recommended")
                            {
                                <span class="badge bg-warning text-dark">@item.AgeLimit</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.AgeLimit</span>
                            }
                        </td>
                        <td class="text-center">@item.RoomNumber</td>
                        @if (User.IsInRole(RoleNames.Admin) || SignInManager.IsSignedIn(User))
                        {
                            <td class="text-center">
                                @if (canManage)
                                {
                                    <div class="action-buttons justify-content-center">
                                        <a href="@Url.Action("Edit", "Booking", new { id = item.Id, returnUrl = Url.Action("Index") + filterQueryPrefix })" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", "Booking", new { id = item.Id, returnUrl = Url.Action("Index") + filterQueryPrefix })" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script id="near-bookings-data" type="application/json">@Html.Raw(Json.Serialize(Model.NearBookings))</script>
    <script src="~/js/booking-index.js" asp-append-version="true"></script>
    
    <script>
        $(document).ready(function() {
            $('#bookingsTable').DataTable({
                responsive: true,
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                order: [[3, 'asc']],
                columnDefs: [
                    { targets: [3, 4], type: 'datetime-moment' }
                ],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search bookings...",
                    emptyTable: "No bookings found",
                    zeroRecords: "No matching bookings found"
                }
            });

            $('.filter-checkbox').on('change', function() {
                $('#filterForm').submit();
            });

            $('#myBookingsToggle').on('click', function() {
                var input = $('#myBookingsInput');
                input.val(input.val() === 'true' ? 'false' : 'true');
                $('#filterForm').submit();
            });
        });
    </script>
}
