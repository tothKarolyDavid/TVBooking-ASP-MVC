@using Microsoft.AspNetCore.Identity
@using TVBookingMVC.Areas.Identity.Data
@using TVBookingMVC.Constants


@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@model IEnumerable<TVBookingMVC.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var ageLimits = ViewBag.AgeLimits as IEnumerable<string> ?? Array.Empty<string>();
    var selectedAgeLimits = ViewBag.SelectedAgeLimits as string[] ?? Array.Empty<string>();
    var currentUserRoomNumber = ViewBag.CurrentUserRoomNumber as int?;

    var ageLimitQuery = string.Join("&", selectedAgeLimits.Select(a => $"ageLimit={Uri.EscapeDataString(a)}"));
    var ageLimitQueryPrefix = !string.IsNullOrEmpty(ageLimitQuery) ? "?" + ageLimitQuery : "";
}

<div class="page-header d-flex justify-content-between align-items-center page-content">
    <h1><i class="bi bi-list-check"></i> @ViewData["Title"]</h1>
    
    @if (SignInManager.IsSignedIn(User))
    {
        <a href="@Url.Action("Create", "Booking")@(ageLimitQueryPrefix)" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Create booking
        </a>
    }
</div>

<div class="card mb-3">
    <div class="card-header" data-bs-toggle="collapse" data-bs-target="#filterCollapse" role="button" aria-expanded="true">
        <h5 class="mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-funnel me-1"></i>Filter by Age Limit
            @if (selectedAgeLimits.Length > 0)
            {
                <span class="badge bg-primary rounded-pill">@selectedAgeLimits.Length</span>
            }
            <i class="bi bi-chevron-down ms-auto transition-rotate rotated"></i>
        </h5>
    </div>
    <div class="collapse show" id="filterCollapse">
        <div class="card-body filter-checks">
            <form asp-action="Index" method="get" id="filterForm">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @foreach (var ageLimit in ageLimits)
                    {
                        bool isChecked = selectedAgeLimits.Contains(ageLimit);
                        <div class="form-check">
                            <input class="form-check-input filter-checkbox" type="checkbox" name="ageLimit" value="@ageLimit" @(isChecked ? "checked" : "") id="age-@ageLimit" />
                            <label class="form-check-label" for="age-@ageLimit">@ageLimit</label>
                        </div>
                    }
                </div>
                @if (selectedAgeLimits.Length > 0)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </a>
                }
            </form>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table id="bookingsTable" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Program</th>
                    <th>Channel</th>
                    <th>Genre</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Age Limit</th>
                    <th>Room</th>
                    @if (User.IsInRole(RoleNames.Admin) || SignInManager.IsSignedIn(User))
                    {
                        <th class="text-center">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var canManage = User.IsInRole(RoleNames.Admin) || (currentUserRoomNumber.HasValue && item.RoomNumber == currentUserRoomNumber.Value);
                    <tr>
                        <td>@item.Program</td>
                        <td>@item.Channel</td>
                        <td>@item.Genre</td>
                        <td>@item.Start.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>@item.End.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            @if (item.AgeLimit == "18+")
                            {
                                <span class="badge bg-danger">@item.AgeLimit</span>
                            }
                            else if (item.AgeLimit == "12+")
                            {
                                <span class="badge bg-warning text-dark">@item.AgeLimit</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.AgeLimit</span>
                            }
                        </td>
                        <td class="text-center">@item.RoomNumber</td>
                        @if (User.IsInRole(RoleNames.Admin) || SignInManager.IsSignedIn(User))
                        {
                            <td class="text-center">
                                @if (canManage)
                                {
                                    <div class="action-buttons justify-content-center">
                                        <a href="@Url.Action("Edit", "Booking", new { id = item.Id, returnUrl = Url.Action("Index") + ageLimitQueryPrefix })" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", "Booking", new { id = item.Id, returnUrl = Url.Action("Index") + ageLimitQueryPrefix })" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script id="near-bookings-data" type="application/json">@Html.Raw(Json.Serialize(ViewBag.NearBookings ?? Array.Empty<TVBookingMVC.Models.Booking>()))</script>
    <script src="~/js/booking-index.js" asp-append-version="true"></script>
    
    <script>
        $(document).ready(function() {
            $('#bookingsTable').DataTable({
                responsive: true,
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                order: [[3, 'asc']],
                columnDefs: [
                    { targets: [3, 4], type: 'datetime-moment' }
                ],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search bookings...",
                    emptyTable: "No bookings found",
                    zeroRecords: "No matching bookings found"
                }
            });

            $('.filter-checkbox').on('change', function() {
                $('#filterForm').submit();
            });
        });
    </script>
}