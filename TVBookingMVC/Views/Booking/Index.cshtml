@using Microsoft.AspNetCore.Identity
@using TVBookingMVC.Areas.Identity.Data


@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@model IEnumerable<TVBookingMVC.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var ageLimits = ViewBag.AgeLimits as IEnumerable<string> ?? Array.Empty<string>();
    var selectedAgeLimits = ViewBag.SelectedAgeLimits as string[] ?? Array.Empty<string>();
}

<div class="page-header d-flex justify-content-between align-items-center page-content">
    <h1><i class="bi bi-list-check"></i> @ViewData["Title"]</h1>
    
    @if (SignInManager.IsSignedIn(User))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Create booking
        </a>
    }
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filter by Age Limit</h5>
    </div>
    <div class="card-body filter-checks">
        <form asp-action="IndexWithFilter" method="get" id="filterForm">
            @foreach (var ageLimit in ageLimits)
            {
                bool isChecked = selectedAgeLimits.Contains(ageLimit);
                <div class="form-check form-check-inline me-3">
                    <input class="form-check-input" type="checkbox" name="ageLimit" value="@ageLimit" @(isChecked ? "checked" : "") id="age-@ageLimit" />
                    <label class="form-check-label" for="age-@ageLimit">@ageLimit</label>
                </div>
            }
            <button type="submit" class="btn btn-secondary btn-sm">
                <i class="bi bi-funnel me-1"></i>Apply Filter
            </button>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table id="bookingsTable" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Program</th>
                    <th>Channel</th>
                    <th>Genre</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Age Limit</th>
                    <th>Room</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Program</td>
                        <td>@item.Channel</td>
                        <td>@item.Genre</td>
                        <td>@item.Start.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.End.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (item.AgeLimit == "18+")
                            {
                                <span class="badge bg-danger">@item.AgeLimit</span>
                            }
                            else if (item.AgeLimit == "12+")
                            {
                                <span class="badge bg-warning text-dark">@item.AgeLimit</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.AgeLimit</span>
                            }
                        </td>
                        <td class="text-center">@item.RoomNumber</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script id="near-bookings-data" type="application/json">@Html.Raw(Json.Serialize(ViewBag.NearBookings ?? Array.Empty<TVBookingMVC.Models.Booking>()))</script>
    <script src="~/js/booking-index.js" asp-append-version="true"></script>
    
    <script>
        $(document).ready(function() {
            $('#bookingsTable').DataTable({
                responsive: true,
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                order: [[3, 'asc']],
                columnDefs: [
                    { targets: [3, 4], type: 'datetime-moment' }
                ],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search bookings...",
                    emptyTable: "No bookings found",
                    zeroRecords: "No matching bookings found"
                }
            });
        });
    </script>
}