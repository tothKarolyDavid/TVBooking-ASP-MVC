@model TVBookingMVC.Models.Booking

@{
    ViewBag.Title = "XML Export";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-content">
    <h1><i class="bi bi-download"></i> @ViewBag.Title</h1>
    <p class="text-muted">Export bookings to XML for a specific date</p>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-calendar me-2"></i>Select Date</h5>
            </div>
            <div class="card-body">
                <form asp-action="XmlExport" method="post">
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input class="form-control" asp-format="{0:yyyy-MM-dd}" type="date" name="Date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-download me-2"></i>Export to XML
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    @if (TempData["Message"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                toastr.options = {
                    "positionClass": "toast-top-right",
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "4000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                    "showMethod": "fadeIn",
                    "hideMethod": "fadeOut",
                    "closeButton": true,
                    "tapToDismiss": false
                };
                toastr.success('@TempData["Message"]', 'Success');
            });
        </script>
    }
}