@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-5 mb-4">
        <div class="card">
            <div class="card-header text-center">
                <h1><i class="bi bi-calendar-event"></i> @ViewData["Title"]</h1>
            </div>
            <div class="card-body">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" id="email"/>
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.RoomNumber" class="form-control" aria-required="true" placeholder="Room number" id="roomnumber"/>
                        <label asp-for="Input.RoomNumber" class="form-label">Room number</label>
                        <span asp-validation-for="Input.RoomNumber" class="text-danger"></span>
                    </div>

                    <div class="checkbox mb-3">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Log in
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <style>
            .demo-credential { cursor: pointer; }
            .demo-credential:hover { text-decoration: underline; }
        </style>
        <div class="demo-credentials">
            <h5><i class="bi bi-info-circle me-2"></i>Demo Credentials</h5>
            <p class="demo-credential" data-email="room2@hotel.com" data-room="2" role="button" tabindex="0"><strong>User:</strong> room2@hotel.com / 2</p>
            <p class="demo-credential" data-email="admin@hotel.com" data-room="0" role="button" tabindex="0"><strong>Admin:</strong> admin@hotel.com / 0</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.demo-credential').forEach(function(el) {
            el.addEventListener('click', function() {
                document.getElementById('email').value = this.dataset.email;
                document.getElementById('roomnumber').value = this.dataset.room;
            });
        });

        function addValidationClasses() {
            var emailError = document.querySelector('span[data-valmsg-for="Input.Email"]');
            var roomError = document.querySelector('span[data-valmsg-for="Input.RoomNumber"]');
            
            if (emailError && emailError.textContent.trim()) {
                var el = document.getElementById("email");
                if (el) el.classList.add("is-invalid");
            }
            if (roomError && roomError.textContent.trim()) {
                var el = document.getElementById("roomnumber");
                if (el) el.classList.add("is-invalid");
            }
        }
        
        addValidationClasses();
        setTimeout(addValidationClasses, 100);
    </script>
}