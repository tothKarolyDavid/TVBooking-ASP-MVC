@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-5 mb-4">
        <div class="card">
            <div class="card-header text-center">
                <h1><i class="bi bi-person-plus"></i> @ViewData["Title"]</h1>
            </div>
            <div class="card-body">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <h2>Create a new guest account.</h2>
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <select asp-for="Input.RoomNumber" class="form-select" aria-required="true">
                            @if (Model.AvailableRooms.Count == 0)
                            {
                                <option value="" disabled selected>No rooms available</option>
                            }
                            else
                            {
                                <option value="" disabled selected>Select room...</option>
                                @foreach (var room in Model.AvailableRooms)
                                {
                                    <option value="@room">@room</option>
                                }
                            }
                        </select>
                        <label asp-for="Input.RoomNumber" class="form-label">Room number</label>
                        <span asp-validation-for="Input.RoomNumber" class="text-danger"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary" onclick="this.disabled=true; this.form.submit();">
                        <i class="bi bi-person-plus me-2"></i>Register
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function addValidationClasses() {
            var emailError = document.querySelector('span[data-valmsg-for="Input.Email"]');
            var roomError = document.querySelector('span[data-valmsg-for="Input.RoomNumber"]');
            
            if (emailError && emailError.textContent.trim()) {
                var el = document.getElementById("Input_Email");
                if (el) el.classList.add("is-invalid");
            }
            if (roomError && roomError.textContent.trim()) {
                var el = document.getElementById("Input_RoomNumber");
                if (el) el.classList.add("is-invalid");
            }
        }
        
        // Run immediately and also after a short delay
        addValidationClasses();
        setTimeout(addValidationClasses, 100);
    </script>
}